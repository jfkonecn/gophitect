package components

type theme string

const (
Dark theme = "dark"
Light theme = "light"
)

templ ColorPalette(theme theme) {
    <section data-theme={theme} class="color-palette">
        <header>
          <p class="pill">{theme}</p>
          <h2>{theme} Theme</h2>
          <p>This section sets <code>data-theme</code>, so default tag styles should resolve against the section's theme variables.</p>
        </header>
        <article>
          <h3>Text Content</h3>
          <p>Paragraph copy uses weak text for comfortable reading. A <a href="/design-system">text link</a>, <strong>strong phrase</strong>, <em>emphasized phrase</em>, <mark>mark element</mark>, <code>inline code</code>, <kbd>kbd</kbd>, and <small>small note</small> should all remain legible.</p>
          <blockquote>Use blockquotes for quoted or highlighted narrative content.</blockquote>
          <h4>Lists</h4>
          <ul>
            <li>Unordered item one</li>
            <li>Unordered item two</li>
          </ul>
          <ol>
            <li>Ordered item one</li>
            <li>Ordered item two</li>
          </ol>
          <pre><code>theme.name = "{theme}"
theme.active = true</code></pre>
        </article>
        <article>
          <h3>Table</h3>
          <table>
            <thead>
              <tr>
                <th>Token</th>
                <th>Use</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>brand</code></td>
                <td>Links, focus, and primary actions</td>
              </tr>
              <tr>
                <td><code>stroke</code></td>
                <td>Borders and low-emphasis separation</td>
              </tr>
            </tbody>
          </table>
        </article>
        <form>
          <fieldset>
            <legend>Text Inputs</legend>

            <p>
              <label for={string(theme) + "-name"}>Name</label>
              <input
                id={string(theme) + "-name"}
                name="name"
                type="text"
                required
                minlength="2"
                maxlength="50"
                autocomplete="name"
              >
            </p>

            <p>
              <label for={string(theme) + "-username"}>Username</label>
              <input
                id={string(theme) + "-username"}
                name="username"
                type="text"
                required
                minlength="3"
                maxlength="20"
                pattern="[A-Za-z0-9_]+"
                title="Use only letters, numbers, and underscores."
              >
            </p>

            <p>
              <label for={string(theme) + "-password"}>Password</label>
              <input
                id={string(theme) + "-password"}
                name="password"
                type="password"
                required
                minlength="8"
              >
            </p>

            <p>
              <label for={string(theme) + "-email"}>Email</label>
              <input
                id={string(theme) + "-email"}
                name="email"
                type="email"
                required
                autocomplete="email"
              >
            </p>

            <p>
              <label for={string(theme) + "-phone"}>Phone</label>
              <input
                id={string(theme) + "-phone"}
                name="phone"
                type="tel"
                required
                pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                placeholder="555-555-5555"
                title="Enter a phone number in the format 555-555-5555."
                autocomplete="tel"
              >
            </p>

            <p>
              <label for={string(theme) + "-website"}>Website</label>
              <input
                id={string(theme) + "-website"}
                name="website"
                type="url"
                placeholder="https://example.com"
              >
            </p>

            <p>
              <label for={string(theme) + "-search"}>Search</label>
              <input
                id={string(theme) + "-search"}
                name="search"
                type="search"
                minlength="2"
              >
            </p>
          </fieldset>

          <fieldset>
            <legend>Numbers</legend>

            <p>
              <label for={string(theme) + "-age"}>Age</label>
              <input
                id={string(theme) + "-age"}
                name="age"
                type="number"
                required
                min="18"
                max="120"
                step="1"
              >
            </p>

            <p>
              <label for={string(theme) + "-price"}>Price</label>
              <input
                id={string(theme) + "-price"}
                name="price"
                type="number"
                min="0"
                max="10000"
                step="0.01"
              >
            </p>

            <p>
              <label for={string(theme) + "-rating"}>Rating</label>
              <input
                id={string(theme) + "-rating"}
                name="rating"
                type="range"
                min="0"
                max="10"
                step="1"
                value="5"
              >
            </p>
          </fieldset>

          <fieldset>
            <legend>Dates and Times</legend>

            <p>
              <label for={string(theme) + "-date"}>Date</label>
              <input
                id={string(theme) + "-date"}
                name="date"
                type="date"
                required
                min="2026-01-01"
                max="2030-12-31"
              >
            </p>

            <p>
              <label for={string(theme) + "-time"}>Time</label>
              <input
                id={string(theme) + "-time"}
                name="time"
                type="time"
                required
                min="08:00"
                max="18:00"
              >
            </p>

            <p>
              <label for={string(theme) + "-datetime"}>Date and time</label>
              <input
                id={string(theme) + "-datetime"}
                name="datetime"
                type="datetime-local"
              >
            </p>

            <p>
              <label for={string(theme) + "-month"}>Month</label>
              <input
                id={string(theme) + "-month"}
                name="month"
                type="month"
              >
            </p>

            <p>
              <label for={string(theme) + "-week"}>Week</label>
              <input
                id={string(theme) + "-week"}
                name="week"
                type="week"
              >
            </p>
          </fieldset>

          <fieldset>
            <legend>Choices</legend>

            <p>Preferred contact method</p>

            <p>
              <input
                id={string(theme) + "-contact-email"}
                name="contact-method"
                type="radio"
                value="email"
                required
              >
              <label for={string(theme) + "-contact-email"}>Email</label>
            </p>

            <p>
              <input
                id={string(theme) + "-contact-phone"}
                name="contact-method"
                type="radio"
                value="phone"
              >
              <label for={string(theme) + "-contact-phone"}>Phone</label>
            </p>

            <p>
              <input
                id={string(theme) + "-terms"}
                name="terms"
                type="checkbox"
                required
              >
              <label for={string(theme) + "-terms"}>
                I agree to the terms
              </label>
            </p>

            <p>
              <input
                id={string(theme) + "-newsletter"}
                name="newsletter"
                type="checkbox"
              >
              <label for={string(theme) + "-newsletter"}>
                Subscribe to newsletter
              </label>
            </p>
          </fieldset>

          <fieldset>
            <legend>Select Elements</legend>

            <p>
              <label for={string(theme) + "-country"}>Country</label>
              <select id={string(theme) + "-country"} name="country" required>
                <option value="">Select a country</option>
                <option value="us">United States</option>
                <option value="ca">Canada</option>
                <option value="mx">Mexico</option>
              </select>
            </p>

            <p>
              <label for={string(theme) + "-languages"}>Languages</label>
              <select
                id={string(theme) + "-languages"}
                name="languages"
                multiple
                size="4"
                required
              >
                <option value="html">HTML</option>
                <option value="css">CSS</option>
                <option value="javascript">JavaScript</option>
                <option value="go">Go</option>
              </select>
            </p>
          </fieldset>

          <fieldset>
            <legend>Other Inputs</legend>

            <p>
              <label for={string(theme) + "-color"}>Favorite color</label>
              <input
                id={string(theme) + "-color"}
                name="color"
                type="color"
                value="#315f7d"
              >
            </p>

            <p>
              <label for={string(theme) + "-file"}>Upload file</label>
              <input
                id={string(theme) + "-file"}
                name="file"
                type="file"
                required
                accept=".png,.jpg,.jpeg,.pdf"
              >
            </p>

            <p>
              <label for={string(theme) + "-files"}>Upload multiple files</label>
              <input
                id={string(theme) + "-files"}
                name="files"
                type="file"
                multiple
                accept="image/*"
              >
            </p>

            <input
              type="hidden"
              name="source"
              value="html-form-demo"
            >
          </fieldset>

          <fieldset>
            <legend>Textarea</legend>

            <p>
              <label for={string(theme) + "-comments"}>Comments</label>
              <textarea
                id={string(theme) + "-comments"}
                name="comments"
                required
                minlength="10"
                maxlength="500"
                rows="6"
                cols="40"
                placeholder="Enter at least 10 characters"
              ></textarea>
            </p>
          </fieldset>

          <fieldset>
            <legend>Data List</legend>

            <p>
              <label for={string(theme) + "-browser"}>Browser</label>
              <input
                id={string(theme) + "-browser"}
                name="browser"
                list={string(theme) + "-browsers"}
                required
              >

              <datalist id={string(theme) + "-browsers"}>
                <option value="Firefox"/>
                <option value="Chrome"/>
                <option value="Safari"/>
                <option value="Edge"/>
              </datalist>
            </p>
          </fieldset>

          <fieldset>
            <legend>Read-only and Disabled</legend>

            <p>
              <label for={string(theme) + "-account-id"}>Account ID</label>
              <input
                id={string(theme) + "-account-id"}
                name="account-id"
                type="text"
                value="ABC-123"
                readonly
              >
            </p>

            <p>
              <label for={string(theme) + "-disabled-input"}>Disabled input</label>
              <input
                id={string(theme) + "-disabled-input"}
                name="disabled-input"
                type="text"
                value="Cannot edit this"
                disabled
              >
            </p>
          </fieldset>

          <fieldset>
            <legend>Buttons</legend>

            <button type="submit">Submit</button>
            <button type="reset">Reset</button>
            <button type="button">Regular Button</button>

            <input type="submit" value="Submit Input">
            <input type="reset" value="Reset Input">
            <input type="button" value="Button Input">
          </fieldset>
        </form>
    </section>
}
