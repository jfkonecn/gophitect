package pages

import "github.com/jfkonecn/gophitect/internal/features/common/layouts"

templ IndexPage() {
	@layouts.Base("Gophitect") {
		<main class="grid flex-1 place-items-center bg-slate-900 px-6 text-slate-50">
			<section class="w-full max-w-2xl rounded-3xl border border-white/20 bg-white/10 p-12 text-center shadow-2xl">
				<h1 class="mb-3 text-6xl font-bold tracking-tighter">Gophitect</h1>
				<p class="text-lg text-slate-300">A simple index page.</p>
			</section>
		</main>
	}
}
