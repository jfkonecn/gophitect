package components

templ ColorPalette() {
    {{
        palettes := []string{"normal","brand","success","warning","error"}
    }}
    <section class="design-system-section color-palettes">
        <h2>Color Palettes</h2>
        <ul>
            for _, palette := range palettes {
                <li class="color-palette">
                    <h3>{ palette }</h3>
                    <ul class={ palette }>
                        if palette != "normal" {
                            <li class="text">Text</li>
                        } else {
                            <li class="text-strong">Text Strong</li>
                            <li class="text-weak">Text Weak</li>
                        }
                        <li class="stroke-strong">Stroke Strong</li>
                        <li class="stroke-weak">Stroke Weak</li>
                        <li class="fill">Fill</li>
                    </ul>
                </li>
            }
        </ul>
    </section>
}
