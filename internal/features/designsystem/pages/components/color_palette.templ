package components

type theme string

const (
Dark theme = "dark"
Light theme = "light"
)

templ ColorPalette(theme theme) {
    <section data-theme={theme} class="color-palette">
        <form>
          <fieldset>
            <legend>Text Inputs</legend>

            <p>
              <label for="name">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                minlength="2"
                maxlength="50"
                autocomplete="name"
              >
            </p>

            <p>
              <label for="username">Username</label>
              <input
                id="username"
                name="username"
                type="text"
                required
                minlength="3"
                maxlength="20"
                pattern="[A-Za-z0-9_]+"
                title="Use only letters, numbers, and underscores."
              >
            </p>

            <p>
              <label for="password">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                required
                minlength="8"
              >
            </p>

            <p>
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
              >
            </p>

            <p>
              <label for="phone">Phone</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                required
                pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                placeholder="555-555-5555"
                title="Enter a phone number in the format 555-555-5555."
                autocomplete="tel"
              >
            </p>

            <p>
              <label for="website">Website</label>
              <input
                id="website"
                name="website"
                type="url"
                placeholder="https://example.com"
              >
            </p>

            <p>
              <label for="search">Search</label>
              <input
                id="search"
                name="search"
                type="search"
                minlength="2"
              >
            </p>
          </fieldset>

          <fieldset>
            <legend>Numbers</legend>

            <p>
              <label for="age">Age</label>
              <input
                id="age"
                name="age"
                type="number"
                required
                min="18"
                max="120"
                step="1"
              >
            </p>

            <p>
              <label for="price">Price</label>
              <input
                id="price"
                name="price"
                type="number"
                min="0"
                max="10000"
                step="0.01"
              >
            </p>

            <p>
              <label for="rating">Rating</label>
              <input
                id="rating"
                name="rating"
                type="range"
                min="0"
                max="10"
                step="1"
                value="5"
              >
            </p>
          </fieldset>

          <fieldset>
            <legend>Dates and Times</legend>

            <p>
              <label for="date">Date</label>
              <input
                id="date"
                name="date"
                type="date"
                required
                min="2026-01-01"
                max="2030-12-31"
              >
            </p>

            <p>
              <label for="time">Time</label>
              <input
                id="time"
                name="time"
                type="time"
                required
                min="08:00"
                max="18:00"
              >
            </p>

            <p>
              <label for="datetime">Date and time</label>
              <input
                id="datetime"
                name="datetime"
                type="datetime-local"
              >
            </p>

            <p>
              <label for="month">Month</label>
              <input
                id="month"
                name="month"
                type="month"
              >
            </p>

            <p>
              <label for="week">Week</label>
              <input
                id="week"
                name="week"
                type="week"
              >
            </p>
          </fieldset>

          <fieldset>
            <legend>Choices</legend>

            <p>Preferred contact method</p>

            <p>
              <input
                id="contact-email"
                name="contact-method"
                type="radio"
                value="email"
                required
              >
              <label for="contact-email">Email</label>
            </p>

            <p>
              <input
                id="contact-phone"
                name="contact-method"
                type="radio"
                value="phone"
              >
              <label for="contact-phone">Phone</label>
            </p>

            <p>
              <input
                id="terms"
                name="terms"
                type="checkbox"
                required
              >
              <label for="terms">
                I agree to the terms
              </label>
            </p>

            <p>
              <input
                id="newsletter"
                name="newsletter"
                type="checkbox"
              >
              <label for="newsletter">
                Subscribe to newsletter
              </label>
            </p>
          </fieldset>

          <fieldset>
            <legend>Select Elements</legend>

            <p>
              <label for="country">Country</label>
              <select id="country" name="country" required>
                <option value="">Select a country</option>
                <option value="us">United States</option>
                <option value="ca">Canada</option>
                <option value="mx">Mexico</option>
              </select>
            </p>

            <p>
              <label for="languages">Languages</label>
              <select
                id="languages"
                name="languages"
                multiple
                size="4"
                required
              >
                <option value="html">HTML</option>
                <option value="css">CSS</option>
                <option value="javascript">JavaScript</option>
                <option value="go">Go</option>
              </select>
            </p>
          </fieldset>

          <fieldset>
            <legend>Other Inputs</legend>

            <p>
              <label for="color">Favorite color</label>
              <input
                id="color"
                name="color"
                type="color"
                value="#315f7d"
              >
            </p>

            <p>
              <label for="file">Upload file</label>
              <input
                id="file"
                name="file"
                type="file"
                required
                accept=".png,.jpg,.jpeg,.pdf"
              >
            </p>

            <p>
              <label for="files">Upload multiple files</label>
              <input
                id="files"
                name="files"
                type="file"
                multiple
                accept="image/*"
              >
            </p>

            <input
              type="hidden"
              name="source"
              value="html-form-demo"
            >
          </fieldset>

          <fieldset>
            <legend>Textarea</legend>

            <p>
              <label for="comments">Comments</label>
              <textarea
                id="comments"
                name="comments"
                required
                minlength="10"
                maxlength="500"
                rows="6"
                cols="40"
                placeholder="Enter at least 10 characters"
              ></textarea>
            </p>
          </fieldset>

          <fieldset>
            <legend>Data List</legend>

            <p>
              <label for="browser">Browser</label>
              <input
                id="browser"
                name="browser"
                list="browsers"
                required
              >

              <datalist id="browsers">
                <option value="Firefox"/>
                <option value="Chrome"/>
                <option value="Safari"/>
                <option value="Edge"/>
              </datalist>
            </p>
          </fieldset>

          <fieldset>
            <legend>Read-only and Disabled</legend>

            <p>
              <label for="account-id">Account ID</label>
              <input
                id="account-id"
                name="account-id"
                type="text"
                value="ABC-123"
                readonly
              >
            </p>

            <p>
              <label for="disabled-input">Disabled input</label>
              <input
                id="disabled-input"
                name="disabled-input"
                type="text"
                value="Cannot edit this"
                disabled
              >
            </p>
          </fieldset>

          <fieldset>
            <legend>Buttons</legend>

            <button type="submit">Submit</button>
            <button type="reset">Reset</button>
            <button type="button">Regular Button</button>

            <input type="submit" value="Submit Input">
            <input type="reset" value="Reset Input">
            <input type="button" value="Button Input">
          </fieldset>
        </form>
    </section>
}
