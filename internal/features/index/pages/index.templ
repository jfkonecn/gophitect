package pages

import (
	"github.com/jfkonecn/gophitect/internal/features/common/components"
	"github.com/jfkonecn/gophitect/internal/features/common/layouts"
)

templ IndexPage(title string) {
	@layouts.Base(title) {
		<div class="flex flex-col w-full min-h-screen">
			@components.Navigation(components.PageIndex)
			<div id="todos-container" data-init={ "@get('/api/todos')" }></div>
		</div>
	}
}
